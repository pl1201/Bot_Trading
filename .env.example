# OKX API Configuration
# Get from: https://www.okx.com/account/my-api
# Permissions needed: Trade + Read
OKX_API_KEY=your_api_key_here
OKX_API_SECRET=your_api_secret_here
OKX_PASSPHRASE=your_passphrase_here

# Telegram Bot Configuration (Optional)
# Leave empty if you don't want Telegram notifications
# Get bot token from @BotFather on Telegram
# Get chat ID from @userinfobot on Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Trading Configuration (Optional - can override via command line)
# DEFAULT_SYMBOL=BTC/USDT
# DEFAULT_POSITION_SIZE=0.02
# DEFAULT_CHECK_INTERVAL=3600
